---
import FeatureVisual from './FeatureVisual.astro';
import Icon, { type IconName } from './Icon.astro';
import { about } from '../data/site';

const statementWords = about.statement.flatMap((segment) =>
  segment.text.split(' ').map((text) => ({ text, key: 'key' in segment && segment.key })),
);

const audienceIcons: Record<(typeof about.audiences)[number]['icon'], IconName> = {
  startup: 'sprout',
  established: 'building',
  growth: 'trend',
};
---

<section id="about" class="about section" aria-labelledby="about-title">
  <div class="container">
    <header class="about-head">
      <p class="label" data-reveal><span class="label-index">01</span> About us</p>
      <h2 id="about-title" class="about-title" data-reveal style="--stagger: 1">
        {about.heading.before} <span class="marker">{about.heading.highlight}</span>
      </h2>
    </header>

    <p class="about-statement" data-scroll-text style={`--n: ${statementWords.length}`}>
      {
        statementWords.map((word, index) => (
          <>
            <span class:list={['sw', { 'is-key': word.key }]} style={`--i: ${index}`}>
              {word.text}
            </span>{' '}
          </>
        ))
      }
    </p>

    <div class="about-intro">
      <p class="about-intro-text" data-reveal>
        {about.intro} <span class="marker">{about.introHighlight}</span>
      </p>

      <ul class="audiences" role="list">
        {
          about.audiences.map((audience, index) => (
            <li class="audience" data-reveal style={`--stagger: ${index + 1}`}>
              <span class="audience-icon">
                <Icon name={audienceIcons[audience.icon]} size={22} />
              </span>
              <span class="audience-title">{audience.title}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="features">
      {
        about.features.map((feature, index) => (
          <article class="feature" data-reveal style={`--stagger: ${index}`}>
            <FeatureVisual variant={feature.visual} />
            <div class="feature-body">
              <span class="feature-index" aria-hidden="true">
                0{index + 1}
              </span>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="vision theme-dark" data-reveal>
      <div class="vision-bg" aria-hidden="true"></div>
      <svg class="vision-mark" viewBox="0 0 64 64" aria-hidden="true">
        <path d="M16.5 34.5 26 44 47 21.5" pathLength="1"></path>
        <path d="M35.5 21H47V32.5" pathLength="1"></path>
      </svg>
      <div class="vision-content">
        <h3 class="label vision-label">
          <span class="label-index"><Icon name="spark" size={14} strokeWidth={2} /></span>
          {about.vision.label}
        </h3>
        <p class="vision-statement">
          {about.vision.statement.before} <span class="accent">{about.vision.statement.accent}</span>
        </p>
        <p class="vision-promise">
          <span class="vision-promise-icon" aria-hidden="true">
            <Icon name="check" size={16} strokeWidth={2.5} />
          </span>
          {about.vision.promise}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--paper);
    padding-top: calc(var(--section-space) - 1rem);
  }

  .about-head {
    display: grid;
    gap: 1.25rem;
    max-width: 52rem;
  }

  .about-title {
    font-size: var(--step-4);
    letter-spacing: -0.04em;
  }

  /* Scroll-revealed statement ------------------------------------------ */
  .about-statement {
    --p: 1;
    max-width: 30em;
    margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.28;
    letter-spacing: -0.03em;
    color: var(--ink-900);
    text-wrap: pretty;
  }

  .sw {
    opacity: calc(0.22 + 0.78 * clamp(0, (var(--p) * (var(--n) + 6) - var(--i)) / 6, 1));
  }

  .sw.is-key {
    color: var(--brand-700);
  }

  /* Visitors who ask for more contrast get the plain, fully legible text. */
  @media (prefers-contrast: more) {
    .sw {
      opacity: 1;
    }
  }

  /* Intro + audiences --------------------------------------------------- */
  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: end;
    gap: 2.5rem clamp(2rem, 1rem + 4vw, 5rem);
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border-top: 1px solid var(--slate-200);
  }

  .about-intro-text {
    font-size: var(--step-1);
    line-height: 1.65;
    color: var(--slate-600);
  }

  .audiences {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .audience {
    display: grid;
    gap: 1.6rem;
    padding: 1.2rem 1.15rem 1.25rem;
    border: 1px solid var(--slate-100);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    transition:
      translate 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out),
      border-color 0.5s ease;
  }

  .audience:hover {
    translate: 0 -4px;
    border-color: var(--brand-200);
    box-shadow: var(--shadow-md);
  }

  .audience-icon {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 0.9rem;
    color: var(--brand-700);
    background: var(--brand-50);
    transition:
      color 0.4s ease,
      background-color 0.4s ease,
      rotate 0.5s var(--ease-spring);
  }

  .audience:hover .audience-icon {
    color: var(--white);
    background: var(--brand-600);
    rotate: -8deg;
  }

  .audience-title {
    color: var(--ink-900);
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  /* Feature cards -------------------------------------------------------- */
  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }

  .feature {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding: 0.9rem 0.9rem 1.6rem;
    border: 1px solid var(--slate-100);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    transition:
      translate 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out),
      border-color 0.5s ease;
  }

  .feature:hover {
    translate: 0 -6px;
    border-color: var(--brand-100);
    box-shadow: var(--shadow-lg);
  }

  .feature-body {
    display: grid;
    gap: 0.7rem;
    padding-inline: 0.6rem;
  }

  .feature-index {
    font-family: var(--font-code);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    color: var(--brand-700);
  }

  .feature h3 {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
  }

  .feature p {
    font-size: 0.97rem;
    line-height: 1.7;
    color: var(--slate-600);
  }

  /* Vision banner -------------------------------------------------------- */
  .vision {
    position: relative;
    isolation: isolate;
    margin-top: 1.25rem;
    padding: clamp(2.2rem, 1.5rem + 4vw, 4.5rem);
    border-radius: var(--radius-xl);
    background: var(--ink-900);
    overflow: clip;
  }

  .vision-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 90% at 100% 0%, rgb(3 169 244 / 0.3), transparent 60%),
      radial-gradient(40% 70% at 0% 100%, rgb(63 217 160 / 0.14), transparent 60%);
  }

  .vision-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(90deg, transparent, #000 60%);
  }

  .vision-mark {
    position: absolute;
    right: clamp(-3rem, -1rem - 2vw, -1rem);
    bottom: -2.5rem;
    width: clamp(12rem, 8rem + 16vw, 22rem);
    height: auto;
    z-index: -1;
    opacity: 0.2;
  }

  .vision-mark path {
    fill: none;
    stroke: var(--brand-300);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.6s var(--ease-in-out) 0.5s;
  }

  .vision-mark path + path {
    transition-delay: 1.5s;
  }

  :global(.js) .vision:not(.is-visible) .vision-mark path {
    stroke-dashoffset: 1;
  }

  .vision-content {
    display: grid;
    gap: 1.6rem;
    max-width: 46rem;
  }

  .vision-label {
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1;
  }

  .vision-statement {
    color: var(--white);
    font-size: var(--step-4);
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .vision-statement .accent {
    color: var(--brand-300);
  }

  .vision-promise {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--slate-200);
    font-size: var(--step-1);
    font-weight: 500;
  }

  .vision-promise-icon {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    flex-shrink: 0;
    color: var(--ink-950);
    background: var(--mint-400);
  }

  /* Responsive ----------------------------------------------------------- */
  @media (max-width: 1080px) {
    .about-intro {
      grid-template-columns: minmax(0, 1fr);
    }

    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .features > :last-child {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
    }

    .features > :last-child :global(.fv) {
      flex: 1 1 50%;
    }

    .features > :last-child .feature-body {
      flex: 1 1 50%;
    }
  }

  @media (max-width: 720px) {
    .audiences,
    .features {
      grid-template-columns: minmax(0, 1fr);
    }

    .audience {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 1rem;
    }

    .features > :last-child {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<script>
  import { addScrollEffect } from '../scripts/scroll';
  import { clamp, prefersReducedMotion } from '../scripts/motion';

  // Words brighten one after another as the statement scrolls up the screen,
  // finishing by the time it reaches the middle of the viewport.
  if (!prefersReducedMotion()) {
    // The text stays fully legible until the effect wakes up just below the
    // viewport, so it never sits dimmed where nobody can scroll it into place.
    document.querySelectorAll<HTMLElement>('[data-scroll-text]').forEach((el) => {
      addScrollEffect(el, (rect, viewportHeight) => {
        const progress = clamp((viewportHeight * 0.9 - rect.top) / (viewportHeight * 0.45));
        el.style.setProperty('--p', progress.toFixed(3));
      });
    });
  }
</script>
