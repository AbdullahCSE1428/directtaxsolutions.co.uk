---
import { Picture } from 'astro:assets';
import Icon, { type IconName } from './Icon.astro';
import calculator from '../assets/images/calculator.jpg';
import { company, contact, formAjaxEndpoint, formEndpoint, links } from '../data/site';

const thankYouUrl = new URL('/thank-you/', Astro.site).href;
const addressLine = `${company.address.street}, ${company.address.locality}, ${company.address.postcode}`;

const methods: Array<{ icon: IconName; kicker: string; value: string; href: string; external?: boolean }> = [
  { icon: 'mail', kicker: 'Email', value: company.email, href: links.email },
  { icon: 'phone', kicker: 'Call', value: company.phone.display, href: links.phone },
  { icon: 'chat', kicker: 'WhatsApp', value: company.phone.display, href: links.whatsapp, external: true },
];

const initials = company.director
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<section id="contact" class="contact section" aria-labelledby="contact-title">
  <div class="container">
    <header class="contact-head">
      <p class="label" data-reveal><span class="label-index">03</span> Contact</p>
      <h2 id="contact-title" class="contact-title" data-reveal style="--stagger: 1">
        {contact.heading.before} <span class="accent">{contact.heading.accent}</span>
      </h2>
    </header>

    <div class="contact-layout">
      <div class="contact-info">
        <a class="office" href={links.maps} target="_blank" rel="noopener" data-reveal>
          <Picture
            src={calculator}
            formats={['avif', 'webp']}
            widths={[480, 760, 1100]}
            sizes="(max-width: 960px) 100vw, 540px"
            width={1100}
            alt=""
            class="office-photo"
          />
          <span class="office-overlay">
            <span class="office-pin"><Icon name="map-pin" size={20} /></span>
            <span class="office-text">
              <span class="office-kicker">Our office</span>
              <span class="office-address">{addressLine}</span>
            </span>
            <span class="office-cta">
              Get directions <Icon name="arrow-up-right" size={16} />
              <span class="sr-only">(opens Google Maps in a new tab)</span>
            </span>
          </span>
        </a>

        <ul class="methods" role="list">
          {
            methods.map((method, index) => (
              <li data-reveal style={`--stagger: ${index + 1}`}>
                <a
                  class="method"
                  href={method.href}
                  target={method.external ? '_blank' : undefined}
                  rel={method.external ? 'noopener' : undefined}
                >
                  <span class="method-icon">
                    <Icon name={method.icon} size={20} />
                  </span>
                  <span class="method-text">
                    <span class="method-kicker">{method.kicker}</span>
                    <span class="method-value">{method.value}</span>
                  </span>
                  <Icon name="arrow-up-right" class="method-arrow" size={20} />
                  {method.external && <span class="sr-only">(opens in a new tab)</span>}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="director" data-reveal style="--stagger: 4">
          <span class="director-avatar" aria-hidden="true">{initials}</span>
          <p class="director-text">
            <span class="director-kicker">Director</span>
            <span class="director-name">{company.director}</span>
          </p>
        </div>
      </div>

      <div class="form-card" data-reveal="scale" data-form-card>
        <div class="form-panel" data-form-panel>
          <h3 id="form-title" class="form-title">{contact.formTitle}</h3>
          <p class="form-intro">
            Prefer a quick chat? <a href={links.whatsapp} target="_blank" rel="noopener">Message us on WhatsApp</a>{' '}
            or call <a href={links.phone}>{company.phone.display}</a>.
          </p>

          <form
            class="form"
            action={formEndpoint}
            method="POST"
            novalidate
            aria-labelledby="form-title"
            data-contact-form
            data-ajax={formAjaxEndpoint}
            data-email={company.email}
          >
            <input type="hidden" name="_subject" value="New enquiry from directtaxsolutions.co.uk" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_next" value={thankYouUrl} />
            <div class="hp" aria-hidden="true">
              <label>
                Leave this field empty
                <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div class="field">
              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
                placeholder=" "
                aria-describedby="name-error"
              />
              <label for="name">Name</label>
              <p class="field-error" id="name-error"></p>
            </div>

            <div class="field">
              <input
                id="email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                spellcheck="false"
                required
                placeholder=" "
                aria-describedby="email-error"
              />
              <label for="email">Email address</label>
              <p class="field-error" id="email-error"></p>
            </div>

            <div class="field">
              <textarea id="message" name="message" rows="5" required placeholder=" " aria-describedby="message-error"
              ></textarea>
              <label for="message">Message</label>
              <p class="field-error" id="message-error"></p>
            </div>

            <div class="form-footer">
              <p class="form-status" role="status" aria-live="polite" data-form-status></p>
              <button class="btn btn-primary submit" type="submit" data-submit>
                <span class="submit-label">Send message</span>
                <Icon name="send" class="submit-icon" size={18} />
                <span class="spinner" aria-hidden="true"></span>
              </button>
            </div>
          </form>
        </div>

        <div class="form-success" data-form-success hidden>
          <svg class="success-check" viewBox="0 0 64 64" aria-hidden="true">
            <circle cx="32" cy="32" r="29" pathLength="1"></circle>
            <path d="M20 33.5l8 8 16.5-17" pathLength="1"></path>
          </svg>
          <h3 class="success-title" tabindex="-1" data-success-title>Thank you — your message has been sent.</h3>
          <p>We’ll be in touch as soon as possible.</p>
          <button class="btn btn-outline" type="button" data-form-reset>Send another message</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    margin-top: calc(var(--radius-xl) * -1);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    background: var(--paper);
  }

  .contact-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .contact-title {
    max-width: 14ch;
    font-size: var(--step-5);
    letter-spacing: -0.045em;
  }

  .contact-title .accent {
    color: var(--brand-700);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: start;
  }

  /* Office card ------------------------------------------------------------ */
  .office {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--white);
    text-decoration: none;
    isolation: isolate;
    box-shadow: var(--shadow-md);
  }

  .office :global(.office-photo) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    scale: 1.02;
    filter: saturate(0.6) brightness(1.35) contrast(1.05);
    transition: scale 1.2s var(--ease-out);
  }

  .office:hover :global(.office-photo) {
    scale: 1.07;
  }

  .office-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: 1fr auto;
    align-items: end;
    gap: 0.4rem 0.85rem;
    padding: 1.2rem 1.3rem;
    background:
      linear-gradient(180deg, rgb(4 12 23 / 0.05) 0%, rgb(4 12 23 / 0.85) 100%),
      linear-gradient(90deg, rgb(3 108 161 / 0.35), transparent 70%);
  }

  .office-pin {
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 0.85rem;
    color: var(--ink-950);
    background: var(--brand-400);
  }

  .office-text {
    display: grid;
    line-height: 1.35;
  }

  .office-kicker,
  .method-kicker,
  .director-kicker {
    font-family: var(--font-code);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .office-kicker {
    color: var(--brand-200);
  }

  .office-address {
    font-weight: 650;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .office-cta {
    grid-column: 1 / -1;
    grid-row: 1;
    align-self: start;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    color: var(--ink-900);
    background: rgb(255 255 255 / 0.92);
    font-size: 0.82rem;
    font-weight: 650;
    transition: background-color 0.3s ease;
  }

  .office:hover .office-cta {
    background: var(--white);
  }

  /* Contact methods ------------------------------------------------------- */
  .methods {
    margin-top: 1rem;
    border-top: 1px solid var(--slate-200);
  }

  .methods li {
    border-bottom: 1px solid var(--slate-200);
  }

  .method {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.05rem 0.25rem;
    text-decoration: none;
    color: var(--ink-900);
  }

  .method-icon {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 0.9rem;
    color: var(--brand-700);
    background: var(--brand-50);
    flex-shrink: 0;
    transition:
      color 0.35s ease,
      background-color 0.35s ease;
  }

  .method-text {
    display: grid;
    min-width: 0;
    line-height: 1.35;
  }

  .method-kicker {
    color: var(--slate-500);
  }

  .method-value {
    font-size: var(--step-1);
    font-weight: 650;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .method :global(.method-arrow) {
    margin-left: auto;
    color: var(--slate-400);
    transition:
      translate 0.35s var(--ease-out),
      color 0.35s ease;
  }

  .method:hover .method-icon {
    color: var(--white);
    background: var(--brand-700);
  }

  .method:hover :global(.method-arrow) {
    color: var(--brand-700);
    translate: 3px -3px;
  }

  .director {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--slate-100);
  }

  .director-avatar {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    color: var(--white);
    background: linear-gradient(135deg, var(--brand-500), var(--ink-700));
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .director-text {
    display: grid;
    line-height: 1.35;
  }

  .director-kicker {
    color: var(--slate-500);
  }

  .director-name {
    color: var(--ink-900);
    font-weight: 700;
    font-size: 1.05rem;
  }

  /* Form card ------------------------------------------------------------ */
  .form-card {
    position: relative;
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.6rem);
    border-radius: var(--radius-xl);
    background: var(--white);
    border: 1px solid var(--slate-100);
    box-shadow: var(--shadow-lg);
  }

  .form-title {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
  }

  .form-intro {
    margin-top: 0.6rem;
    color: var(--slate-500);
    font-size: 0.95rem;
  }

  .form-intro a {
    color: var(--brand-700);
    font-weight: 600;
  }

  .form {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.8rem;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .field {
    position: relative;
  }

  .field input,
  .field textarea {
    display: block;
    width: 100%;
    padding: 1.55rem 1rem 0.6rem;
    border: 1.5px solid var(--slate-200);
    border-radius: var(--radius-sm);
    background: var(--slate-50);
    color: var(--ink-900);
    font-size: 1rem;
    line-height: 1.5;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .field textarea {
    min-height: 9.5rem;
    resize: vertical;
  }

  .field input:hover,
  .field textarea:hover {
    border-color: var(--slate-300);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--brand-600);
    background: var(--white);
    box-shadow: 0 0 0 4px rgb(3 169 244 / 0.16);
  }

  .field label {
    position: absolute;
    top: 1.05rem;
    left: 1rem;
    color: var(--slate-500);
    font-size: 1rem;
    line-height: 1.3;
    pointer-events: none;
    transform-origin: 0 0;
    transition:
      translate 0.25s var(--ease-out),
      scale 0.25s var(--ease-out),
      color 0.25s ease;
  }

  .field input:focus + label,
  .field input:not(:placeholder-shown) + label,
  .field textarea:focus + label,
  .field textarea:not(:placeholder-shown) + label {
    translate: 0 -0.62rem;
    scale: 0.78;
    color: var(--brand-700);
    font-weight: 600;
  }

  .field [aria-invalid='true'] {
    border-color: var(--danger);
    background: #fff7f7;
  }

  .field [aria-invalid='true'] + label {
    color: var(--danger);
  }

  .field-error {
    margin-top: 0.4rem;
    color: var(--danger);
    font-size: 0.86rem;
    font-weight: 550;
  }

  .field-error:empty {
    display: none;
  }

  .form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }

  .form-status {
    flex: 1 1 14rem;
    font-size: 0.9rem;
    color: var(--slate-600);
  }

  .form-status :global(a) {
    color: var(--brand-700);
    font-weight: 600;
  }

  .form-status[data-tone='error'] {
    color: var(--danger);
  }

  .submit {
    margin-left: auto;
  }

  .submit :global(.submit-icon) {
    transition:
      translate 0.4s var(--ease-out),
      opacity 0.3s ease;
  }

  .submit:hover :global(.submit-icon) {
    translate: 3px -3px;
  }

  .spinner {
    position: absolute;
    right: 1.5rem;
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid rgb(4 12 23 / 0.25);
    border-top-color: var(--ink-950);
    border-radius: 50%;
    opacity: 0;
  }

  .submit[data-busy] {
    cursor: progress;
  }

  .submit[data-busy] :global(.submit-icon) {
    opacity: 0;
  }

  .submit[data-busy] .spinner {
    opacity: 1;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }

  /* Success state -------------------------------------------------------- */
  .form-success {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding-block: 3rem;
    text-align: center;
  }

  .form-success[hidden] {
    display: none;
  }

  .success-check {
    width: 5rem;
    height: 5rem;
  }

  .success-check circle {
    fill: #e3f9f0;
    stroke: var(--mint-500);
    stroke-width: 3;
    stroke-dasharray: 1;
    animation: success-draw 0.9s var(--ease-in-out) both;
  }

  .success-check path {
    fill: none;
    stroke: var(--mint-500);
    stroke-width: 4.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    animation: success-draw 0.6s var(--ease-out) 0.6s both;
  }

  .success-title {
    max-width: 18ch;
    font-size: var(--step-3);
    letter-spacing: -0.035em;
  }

  .success-title:focus {
    outline: none;
  }

  .form-success p {
    color: var(--slate-600);
    margin-bottom: 0.75rem;
  }

  @keyframes success-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @media (max-width: 960px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .method-value {
      font-size: 1.04rem;
    }

    .method :global(.method-arrow) {
      display: none;
    }

    .office-overlay {
      padding: 1rem;
    }

    .office-address {
      font-size: 0.95rem;
    }

    .submit {
      width: 100%;
    }
  }
</style>

<script>
  import { initContactForm } from '../scripts/contact-form';
  initContactForm();
</script>
