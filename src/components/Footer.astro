---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { company, links, nav } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer theme-dark">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="footer-logo" href="/#home" aria-label={`${company.name} — home`}>
          <Logo idPrefix="footer-logo" size={44} />
          <span aria-hidden="true">Direct <span class="brand-tax">Tax</span> Solutions</span>
        </a>
        <p class="footer-tagline">A firm of accountants, tax advisors and business mentors.</p>
        <a class="btn btn-primary" href="/#contact">
          Get in touch
          <Icon name="arrow-right" class="btn-arrow" />
        </a>
      </div>

      <div class="footer-cols">
        <div class="footer-col">
          <h2 class="footer-heading">Office</h2>
          <address>
            {company.address.street}<br />
            {company.address.locality}<br />
            {company.address.postcode}
          </address>
          <p class="footer-muted">Director: {company.director}</p>
        </div>

        <div class="footer-col">
          <h2 class="footer-heading">Contact</h2>
          <ul role="list">
            <li><a href={links.email}>{company.email}</a></li>
            <li><a href={links.phone}>Tel: {company.phone.display}</a></li>
            <li>
              <a href={links.whatsapp} target="_blank" rel="noopener">
                WhatsApp<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          </ul>
        </div>

        <nav class="footer-col" aria-label="Footer">
          <h2 class="footer-heading">Explore</h2>
          <ul role="list">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <p class="footer-wordmark" aria-hidden="true" data-reveal>
      Direct Tax Solutions<span>.</span>
    </p>

    <div class="footer-bottom">
      <p>
        &copy; <span data-year>{year}</span>{' '}
        {company.name}. All rights reserved.
      </p>
      <p>
        Registered in {company.jurisdiction} · Company number{' '}
        <a href={links.companiesHouse} target="_blank" rel="noopener">
          {company.number}<span class="sr-only"> (view on Companies House, opens in a new tab)</span>
        </a>
      </p>
      <a class="to-top" href="#">
        Back to top
        <Icon name="arrow-up" size={16} />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    padding-top: clamp(4.5rem, 3rem + 5vw, 7.5rem);
    padding-bottom: 2rem;
    background: var(--ink-950);
    overflow: clip;
  }

  .footer-glow {
    position: absolute;
    inset: auto -10% -40% -10%;
    height: 70%;
    z-index: -1;
    background: radial-gradient(50% 60% at 50% 100%, rgb(3 169 244 / 0.22), transparent 70%);
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: 3rem;
  }

  .footer-brand {
    display: grid;
    justify-items: start;
    gap: 1.4rem;
    align-content: start;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--white);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .brand-tax {
    color: var(--brand-400);
  }

  .footer-tagline {
    max-width: 22rem;
    font-size: var(--step-1);
    color: var(--slate-300);
  }

  .footer-cols {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr) minmax(0, 0.7fr);
    gap: 2rem;
  }

  .footer-heading {
    margin-bottom: 1rem;
    font-family: var(--font-code);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-400);
  }

  .footer-col address {
    font-style: normal;
    line-height: 1.8;
    color: var(--slate-200);
  }

  .footer-muted {
    margin-top: 0.8rem;
    color: var(--slate-400);
    font-size: 0.93rem;
  }

  .footer-col ul {
    display: grid;
    gap: 0.55rem;
  }

  .footer-col a {
    color: var(--slate-200);
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition:
      background-size 0.4s var(--ease-out),
      color 0.3s ease;
  }

  .footer-col a:hover {
    color: var(--white);
    background-size: 100% 1px;
  }

  .footer-wordmark {
    margin-top: clamp(3.5rem, 2rem + 6vw, 7rem);
    /* sized so the full name always fits the container width */
    font-size: min(7.9vw, 6.3rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.065em;
    white-space: nowrap;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.2), rgb(255 255 255 / 0.02) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
  }

  .footer-wordmark span {
    color: var(--brand-500);
    -webkit-text-fill-color: var(--brand-500);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.08);
    color: var(--slate-400);
    font-size: 0.86rem;
  }

  .footer-bottom a {
    color: var(--slate-200);
  }

  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }

  .to-top :global(svg) {
    transition: translate 0.35s var(--ease-out);
  }

  .to-top:hover :global(svg) {
    translate: 0 -3px;
  }

  @media (max-width: 960px) {
    .footer-top {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 620px) {
    .footer-cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .footer-cols > :nth-child(2) {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  // Keep the copyright year current even if the site is not rebuilt for a while.
  const year = String(new Date().getFullYear());
  document.querySelectorAll('[data-year]').forEach((el) => {
    el.textContent = year;
  });
</script>
