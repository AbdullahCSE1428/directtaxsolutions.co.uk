---
/**
 * Decorative “live books” illustration for the hero: a management-accounts
 * chart that draws itself, with status cards for VAT, payroll and company
 * formation popping in around it. Purely illustrative — no real figures.
 */
import Icon from './Icon.astro';

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'];
const actual = [58, 84, 72, 108, 96, 128];
const forecast = [70, 80, 90, 100, 114, 136];

const chart = { width: 460, height: 212, left: 18, right: 442, top: 22, base: 176 };
const band = (chart.right - chart.left) / months.length;
const x = (index: number) => chart.left + band * index + band / 2;
const y = (value: number) => chart.base - value;
const round = (value: number) => Math.round(value * 10) / 10;

type Point = { x: number; y: number };
const points: Point[] = forecast.map((value, index) => ({ x: x(index), y: y(value) }));

/** Smooth curve through the points (Catmull-Rom converted to cubic Béziers). */
function smoothPath(pts: Point[]): string {
  let d = `M${round(pts[0]!.x)},${round(pts[0]!.y)}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i]!;
    const p1 = pts[i]!;
    const p2 = pts[i + 1]!;
    const p3 = pts[i + 2] ?? p2;
    const c1 = { x: p1.x + (p2.x - p0.x) / 6, y: p1.y + (p2.y - p0.y) / 6 };
    const c2 = { x: p2.x - (p3.x - p1.x) / 6, y: p2.y - (p3.y - p1.y) / 6 };
    d += ` C${round(c1.x)},${round(c1.y)} ${round(c2.x)},${round(c2.y)} ${round(p2.x)},${round(p2.y)}`;
  }
  return d;
}

const linePath = smoothPath(points);
const first = points[0]!;
const last = points[points.length - 1]!;
const areaPath = `${linePath} L${round(last.x)},${chart.base} L${round(first.x)},${chart.base} Z`;
const gridLines = [0, 1, 2, 3].map((i) => chart.top + (i * (chart.base - chart.top)) / 3);
---

<div class="hero-visual" aria-hidden="true" data-hero-visual>
  <div class="hv-main">
    <div class="hv-head">
      <span class="hv-head-icon"><Icon name="trend" size={18} /></span>
      <span class="hv-head-text">
        <span class="hv-title">Management accounts</span>
        <span class="hv-sub">Budget vs actual</span>
      </span>
      <span class="hv-seg">
        <span class="is-on">M</span><span>Q</span><span>Y</span>
      </span>
    </div>

    <div class="hv-chart-wrap">
      <svg class="hv-chart" viewBox={`0 0 ${chart.width} ${chart.height}`}>
        <defs>
          <linearGradient id="hv-bar-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#36baf6" stop-opacity="0.95"></stop>
            <stop offset="1" stop-color="#036ca1" stop-opacity="0.35"></stop>
          </linearGradient>
          <linearGradient id="hv-area-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#3fd9a0" stop-opacity="0.32"></stop>
            <stop offset="1" stop-color="#3fd9a0" stop-opacity="0"></stop>
          </linearGradient>
        </defs>

        <g class="hv-grid">
          {gridLines.map((gy) => <line x1={chart.left} x2={chart.right} y1={gy} y2={gy} />)}
        </g>

        <g class="hv-bars">
          {
            actual.map((value, index) => (
              <rect
                x={round(x(index) - 13)}
                y={y(value)}
                width="26"
                height={value}
                rx="7"
                style={`--i: ${index}`}
              />
            ))
          }
        </g>

        <path class="hv-area" d={areaPath}></path>
        <path class="hv-line" d={linePath} pathLength="1"></path>

        <g class="hv-end" transform={`translate(${round(last.x)} ${round(last.y)})`}>
          <circle class="hv-ring" r="6"></circle>
          <circle class="hv-dot" r="5.5"></circle>
        </g>

        <g class="hv-months">
          {
            months.map((month, index) => (
              <text x={round(x(index))} y={chart.height - 8}>
                {month}
              </text>
            ))
          }
        </g>
      </svg>

      <span class="hv-tooltip">
        <Icon name="arrow-up-right" size={13} strokeWidth={2.4} />
        On track
      </span>
    </div>

    <div class="hv-legend">
      <span><i class="hv-key hv-key--actual"></i>Actual</span>
      <span><i class="hv-key hv-key--forecast"></i>Forecast</span>
      <span class="hv-legend-end">Variance analysis</span>
    </div>
  </div>

  <div class="hv-card hv-card--vat" style="--depth: 30">
    <div class="hv-card-inner">
      <span class="hv-card-icon hv-card-icon--brand">
        <svg viewBox="0 0 24 24" width="20" height="20">
          <path d="M6 3h12v18l-2.2-1.4L13.6 21l-1.6-1.4L10.4 21l-2.2-1.4L6 21V3z"></path>
          <path d="M9.5 14.5l5-5"></path>
          <circle cx="9.9" cy="9.9" r="1"></circle>
          <circle cx="14.1" cy="14.1" r="1"></circle>
        </svg>
      </span>
      <span class="hv-card-text">
        <strong>VAT return</strong>
        <span>Submitted online</span>
      </span>
      <svg class="hv-check" viewBox="0 0 24 24" width="26" height="26">
        <circle cx="12" cy="12" r="11"></circle>
        <path d="M7.2 12.4l3.1 3.1 6.4-6.6" pathLength="1"></path>
      </svg>
    </div>
  </div>

  <div class="hv-card hv-card--payroll" style="--depth: 44">
    <div class="hv-card-inner hv-card-inner--stack">
      <div class="hv-card-row">
        <span class="hv-card-icon hv-card-icon--mint">
          <svg viewBox="0 0 24 24" width="20" height="20">
            <circle cx="9" cy="8.5" r="3.2"></circle>
            <path d="M3.5 19.5a5.5 5.5 0 0 1 11 0"></path>
            <circle cx="17" cy="9.5" r="2.6"></circle>
            <path d="M15.2 14.6a4.6 4.6 0 0 1 5.3 4.9"></path>
          </svg>
        </span>
        <span class="hv-card-text">
          <strong>Payroll &amp; PAYE</strong>
          <span class="hv-swap">
            <span class="hv-swap-a">Running payroll…</span>
            <span class="hv-swap-b">Payslips issued</span>
          </span>
        </span>
      </div>
      <span class="hv-progress"><span></span></span>
    </div>
  </div>

  <div class="hv-card hv-card--company" style="--depth: 20">
    <div class="hv-card-inner">
      <span class="hv-card-icon hv-card-icon--ink">
        <svg viewBox="0 0 24 24" width="20" height="20">
          <path d="M4 20.5V9.5L12 4l8 5.5v11"></path>
          <path d="M9.5 20.5v-5h5v5"></path>
          <path d="M2.5 20.5h19"></path>
        </svg>
      </span>
      <span class="hv-card-text">
        <strong>Company formation</strong>
        <span>Registered at Companies House</span>
      </span>
      <svg class="hv-check" viewBox="0 0 24 24" width="26" height="26">
        <circle cx="12" cy="12" r="11"></circle>
        <path d="M7.2 12.4l3.1 3.1 6.4-6.6" pathLength="1"></path>
      </svg>
    </div>
  </div>
</div>

<style>
  .hero-visual {
    --px: 0;
    --py: 0;
    position: relative;
    padding: 3.6rem 2.2rem 5.6rem 0.8rem;
    perspective: 1600px;
  }

  /* The chart drifts up a little faster than the page on wide screens. */
  @media (min-width: 1081px) {
    .hero-visual {
      translate: 0 calc(var(--hero-shift, 0) * -0.06px);
    }
  }

  /* Main chart card ------------------------------------------------------- */
  .hv-main {
    position: relative;
    padding: 1.35rem 1.35rem 1.2rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.075), rgb(255 255 255 / 0.025)),
      rgb(7 24 43 / 0.55);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 40px 90px -30px rgb(0 0 0 / 0.75);
    backdrop-filter: blur(20px);
    transform: rotateY(calc(var(--px) * 5deg)) rotateX(calc(var(--py) * -5deg))
      translate3d(calc(var(--px) * 10px), calc(var(--py) * 10px), 0);
    transform-style: preserve-3d;
    animation: card-in 1.2s var(--ease-out) 0.35s both;
  }

  .hv-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hv-head-icon {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 0.8rem;
    color: var(--brand-300);
    background: rgb(3 169 244 / 0.14);
    box-shadow: inset 0 0 0 1px rgb(3 169 244 / 0.25);
  }

  .hv-head-text {
    display: grid;
    line-height: 1.25;
  }

  .hv-title {
    color: var(--white);
    font-weight: 650;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .hv-sub {
    color: var(--slate-400);
    font-size: 0.78rem;
  }

  .hv-seg {
    display: flex;
    margin-left: auto;
    padding: 0.2rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    font-family: var(--font-code);
    font-size: 0.7rem;
    color: var(--slate-400);
  }

  .hv-seg span {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.5rem;
    border-radius: 999px;
  }

  .hv-seg .is-on {
    color: var(--ink-950);
    background: var(--brand-300);
  }

  .hv-chart-wrap {
    position: relative;
    margin-top: 1rem;
  }

  .hv-chart {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hv-grid line {
    stroke: rgb(255 255 255 / 0.08);
    stroke-dasharray: 3 6;
    animation: fade-in 1s ease 0.7s both;
  }

  .hv-bars rect {
    fill: url(#hv-bar-fill);
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: bar-grow 1.1s var(--ease-out) both;
    animation-delay: calc(0.85s + var(--i) * 80ms);
  }

  .hv-area {
    fill: url(#hv-area-fill);
    animation: fade-in 1.2s ease 2.1s both;
  }

  .hv-line {
    fill: none;
    stroke: var(--mint-400);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 1;
    filter: drop-shadow(0 4px 10px rgb(63 217 160 / 0.45));
    animation: draw 1.7s var(--ease-in-out) 1.15s both;
  }

  .hv-dot {
    fill: var(--mint-300);
    stroke: var(--ink-900);
    stroke-width: 2.5;
    transform-box: fill-box;
    transform-origin: center;
    animation: pop 0.6s var(--ease-spring) 2.75s both;
  }

  .hv-ring {
    fill: var(--mint-400);
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    animation: ring 1.8s var(--ease-out) 3.1s 3;
  }

  .hv-months text {
    fill: rgb(255 255 255 / 0.42);
    font-family: var(--font-code);
    font-size: 11px;
    text-anchor: middle;
  }

  .hv-tooltip {
    position: absolute;
    top: -2%;
    right: 13%;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.32rem 0.6rem;
    border-radius: 999px;
    color: var(--ink-950);
    background: var(--mint-300);
    font-size: 0.72rem;
    font-weight: 700;
    box-shadow: 0 10px 24px -10px rgb(63 217 160 / 0.8);
    animation: pop 0.7s var(--ease-spring) 2.95s both;
  }

  .hv-legend {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-top: 0.85rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgb(255 255 255 / 0.07);
    color: var(--slate-400);
    font-size: 0.76rem;
  }

  .hv-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hv-key {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 3px;
  }

  .hv-key--actual {
    background: var(--brand-400);
  }

  .hv-key--forecast {
    height: 3px;
    width: 0.9rem;
    border-radius: 3px;
    background: var(--mint-400);
  }

  .hv-legend-end {
    margin-left: auto;
    font-family: var(--font-code);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--slate-300);
  }

  /* Floating status cards ------------------------------------------------ */
  .hv-card {
    position: absolute;
    z-index: 2;
    transform: translate3d(calc(var(--px) * var(--depth) * 1px), calc(var(--py) * var(--depth) * 1px), 0);
  }

  .hv-card-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 0.95rem 0.8rem 0.8rem;
    border-radius: 1.1rem;
    color: var(--ink-900);
    background: rgb(255 255 255 / 0.96);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.9) inset,
      0 24px 48px -18px rgb(0 0 0 / 0.55),
      0 0 0 1px rgb(7 24 43 / 0.06);
    animation: float-in 0.9s var(--ease-spring) both;
  }

  .hv-card-inner--stack {
    display: grid;
    gap: 0.7rem;
  }

  .hv-card-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hv-card-icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.75rem;
    flex-shrink: 0;
  }

  .hv-card-icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hv-card-icon--brand {
    color: var(--brand-700);
    background: var(--brand-50);
  }

  .hv-card-icon--mint {
    color: #0b8a5f;
    background: #e3f9f0;
  }

  .hv-card-icon--ink {
    color: var(--white);
    background: var(--ink-800);
  }

  .hv-card-text {
    display: grid;
    line-height: 1.3;
    font-size: 0.76rem;
    color: var(--slate-500);
  }

  .hv-card-text strong {
    color: var(--ink-900);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .hv-check {
    margin-left: 0.35rem;
    flex-shrink: 0;
  }

  .hv-check circle {
    fill: var(--mint-500);
    transform-box: fill-box;
    transform-origin: center;
    animation: pop 0.55s var(--ease-spring) both;
    animation-delay: calc(var(--card-delay) + 0.45s);
  }

  .hv-check path {
    fill: none;
    stroke: var(--white);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    animation: draw 0.5s var(--ease-out) both;
    animation-delay: calc(var(--card-delay) + 0.75s);
  }

  .hv-card--vat {
    --card-delay: 1.45s;
    top: 0.4rem;
    right: 0;
  }

  .hv-card--payroll {
    --card-delay: 1.8s;
    left: -2.2rem;
    bottom: 26%;
    width: 15rem;
  }

  .hv-card--company {
    --card-delay: 2.15s;
    right: -0.6rem;
    bottom: 0.6rem;
  }

  .hv-card-inner {
    animation-delay: var(--card-delay);
  }

  .hv-swap {
    display: grid;
  }

  .hv-swap > span {
    grid-area: 1 / 1;
  }

  .hv-swap-a {
    animation: swap-out 0.4s ease 3.6s both;
  }

  .hv-swap-b {
    color: #0b8a5f;
    font-weight: 600;
    animation: swap-in 0.4s ease 3.7s both;
  }

  .hv-progress {
    position: relative;
    display: block;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--slate-100);
    overflow: hidden;
  }

  .hv-progress span {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--brand-500), var(--mint-400));
    transform-origin: 0 50%;
    animation: progress 1.5s var(--ease-in-out) 2.2s both;
  }

  /* Keyframes ------------------------------------------------------------- */
  @keyframes card-in {
    from {
      opacity: 0;
      translate: 0 2.5rem;
      scale: 0.96;
    }
  }

  @keyframes float-in {
    from {
      opacity: 0;
      translate: 0 1.2rem;
      scale: 0.85;
    }
  }

  @keyframes bar-grow {
    from {
      scale: 1 0;
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      scale: 0.4;
    }
  }

  @keyframes ring {
    from {
      opacity: 0.55;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 3.2;
    }
  }

  @keyframes progress {
    from {
      scale: 0 1;
    }
  }

  @keyframes swap-out {
    to {
      opacity: 0;
      translate: 0 -0.5rem;
    }
  }

  @keyframes swap-in {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  /* Responsive ------------------------------------------------------------ */
  @media (max-width: 1080px) {
    .hero-visual {
      width: min(100%, 36rem);
      margin-inline: auto;
    }
  }

  @media (max-width: 760px) {
    .hv-card--payroll {
      left: -0.4rem;
    }
  }

  @media (max-width: 560px) {
    .hero-visual {
      padding: 3.4rem 0.4rem 5.2rem;
    }

    .hv-main {
      padding: 1rem;
    }

    .hv-seg,
    .hv-legend-end {
      display: none;
    }

    .hv-card-inner {
      padding: 0.6rem 0.7rem 0.6rem 0.6rem;
      gap: 0.55rem;
    }

    .hv-card-icon {
      width: 2rem;
      height: 2rem;
    }

    .hv-card--payroll {
      left: -0.2rem;
      bottom: 0.4rem;
      width: 13.2rem;
    }

    .hv-card--company {
      display: none;
    }

    .hv-card--vat {
      right: -0.2rem;
    }
  }
</style>

<script>
  import { hasFinePointer, prefersReducedMotion } from '../scripts/motion';

  // Pointer parallax: the chart tilts and the status cards float at different depths.
  const visual = document.querySelector<HTMLElement>('[data-hero-visual]');
  const area = visual?.closest<HTMLElement>('.hero');

  if (visual && area && hasFinePointer() && !prefersReducedMotion()) {
    const target = { x: 0, y: 0 };
    const current = { x: 0, y: 0 };
    let frame = 0;

    const tick = () => {
      current.x += (target.x - current.x) * 0.08;
      current.y += (target.y - current.y) * 0.08;
      visual.style.setProperty('--px', current.x.toFixed(4));
      visual.style.setProperty('--py', current.y.toFixed(4));
      const settled = Math.abs(target.x - current.x) < 0.001 && Math.abs(target.y - current.y) < 0.001;
      frame = settled ? 0 : requestAnimationFrame(tick);
    };

    const start = () => {
      if (!frame) frame = requestAnimationFrame(tick);
    };

    area.addEventListener('pointermove', (event) => {
      const rect = visual.getBoundingClientRect();
      target.x = Math.max(-1, Math.min(1, (event.clientX - (rect.left + rect.width / 2)) / (rect.width / 1.2)));
      target.y = Math.max(-1, Math.min(1, (event.clientY - (rect.top + rect.height / 2)) / (rect.height / 1.2)));
      start();
    });

    area.addEventListener('pointerleave', () => {
      target.x = 0;
      target.y = 0;
      start();
    });
  }
</script>
