---
/**
 * The brand mark: a “D” monogram (for Direct) with a rising arrow in its
 * counter, on a deep blue tile. Geometry lives in src/data/brand.ts.
 */
import { logoMark } from '../data/brand';

interface Props {
  size?: number;
  /** Unique prefix so several logos can share a page without clashing gradient ids. */
  idPrefix?: string;
  class?: string;
}

const { size = 36, idPrefix = 'logo', class: className } = Astro.props;
const gradientId = `${idPrefix}-gradient`;
---

<svg
  class:list={['logo-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={gradientId} x1="6" y1="2" x2="58" y2="62" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color={logoMark.gradient[0]}></stop>
      <stop offset="1" stop-color={logoMark.gradient[1]}></stop>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx={logoMark.radius} fill={`url(#${gradientId})`}></rect>
  <path class="logo-letter" d={logoMark.letter} stroke-width={logoMark.letterWidth}></path>
  {logoMark.arrow.map((d) => <path class="logo-arrow" d={d} stroke-width={logoMark.arrowWidth} />)}
</svg>

<style>
  .logo-mark path {
    fill: none;
    stroke: #fff;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
