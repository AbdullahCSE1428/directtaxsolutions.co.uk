---
/**
 * The brand mark: a lowercase “dt” ligature (Direct Tax) in a blue-to-mint
 * gradient. Geometry lives in src/data/brand.ts.
 */
import { logoMark } from '../data/brand';

interface Props {
  size?: number;
  /** Unique prefix so several logos can share a page without clashing gradient ids. */
  idPrefix?: string;
  class?: string;
}

const { size = 36, idPrefix = 'logo', class: className } = Astro.props;
const gradientId = `${idPrefix}-gradient`;
---

<svg
  class:list={['logo-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={gradientId} x1="8" y1="58" x2="56" y2="6" gradientUnits="userSpaceOnUse">
      {logoMark.gradient.map(([offset, color]) => <stop offset={offset} stop-color={color} />)}
    </linearGradient>
  </defs>
  <g stroke={`url(#${gradientId})`} stroke-width={logoMark.strokeWidth}>
    <circle cx={logoMark.bowl.cx} cy={logoMark.bowl.cy} r={logoMark.bowl.r}></circle>
    <path d={logoMark.stem}></path>
    <path d={logoMark.bar}></path>
  </g>
</svg>

<style>
  .logo-mark g {
    fill: none;
    stroke-linecap: round;
  }
</style>
