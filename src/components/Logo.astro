---
/**
 * The brand mark: a capital “DT” ligature (Direct Tax) in a blue-to-mint
 * gradient on a rounded navy tile. Geometry lives in src/data/brand.ts.
 */
import { logoGradient, logoTile } from '../data/brand';

interface Props {
  size?: number;
  /** Unique prefix so several logos can share a page without clashing gradient ids. */
  idPrefix?: string;
  class?: string;
}

const { size = 40, idPrefix = 'logo', class: className } = Astro.props;
const gradientId = `${idPrefix}-gradient`;
---

<svg
  class:list={['logo-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
  set:html={`<defs>${logoGradient(gradientId)}</defs>${logoTile(gradientId, { ring: true })}`}
/>
