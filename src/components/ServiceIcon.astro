---
/** Line illustrations for each service; strokes draw in when the card is revealed. */
import type { ServiceIcon } from '../data/site';

interface Props {
  name: ServiceIcon;
}

const { name } = Astro.props;

const icons: Record<ServiceIcon, string[]> = {
  // Building with a flag on the roof — a new company is born.
  formation: ['M5 29V14.5L16 7.5l11 7V29', 'M12.5 29v-7.5h7V29', 'M3 29h26', 'M16 7.5V2.5l5.2 1.3L16 5.2', 'M10 17.5h2.5M19.5 17.5H22'],
  // Receipt with a percentage sign.
  vat: ['M8 3.5h16v25.5l-2.9-1.9-2.9 1.9-2.2-1.9-2.2 1.9-2.9-1.9L8 29V3.5z', 'M12.5 20.5l7-7', 'M13.2 13.9a.9.9 0 1 0 0-.1', 'M18.8 20.1a.9.9 0 1 0 0-.1', 'M12 8.5h8'],
  // Payslip with a pound sign and lines.
  payroll: ['M6.5 5.5h19A1.5 1.5 0 0 1 27 7v18a1.5 1.5 0 0 1-1.5 1.5h-19A1.5 1.5 0 0 1 5 25V7a1.5 1.5 0 0 1 1.5-1.5z', 'M5 11h22', 'M9.5 16.5h7M9.5 21h5', 'M24 15.2c-.5-.8-1.3-1.2-2.2-1.2-1.4 0-2.3 1-2.3 2.4V22M18.4 18.6h3.6M18.4 22h5.4'],
  // Person with a self-assessment form.
  'personal-tax': ['M9 3.5h10.5l5.5 5.5v19.5H9V3.5z', 'M19.5 3.5V9H25', 'M17 19.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4z', 'M12 25.5a5 5 0 0 1 10 0'],
  // Classical institution — corporation tax & Companies House.
  'corporation-tax': ['M4 12 16 4.5 28 12', 'M5.5 12h21', 'M8.5 15.5v8M13.5 15.5v8M18.5 15.5v8M23.5 15.5v8', 'M5.5 26h21', 'M3.5 29.5h25'],
  // Briefcase with a rising line.
  'business-tax': ['M6.5 10.5h19A2.5 2.5 0 0 1 28 13v12a2.5 2.5 0 0 1-2.5 2.5h-19A2.5 2.5 0 0 1 4 25V13a2.5 2.5 0 0 1 2.5-2.5z', 'M12 10.5V8a2.5 2.5 0 0 1 2.5-2.5h3A2.5 2.5 0 0 1 20 8v2.5', 'M9 22.5l4.5-4 3 2.5 6.5-6', 'M19.5 15H23v3.5'],
};
---

<svg class="service-icon" viewBox="0 0 32 32" width="40" height="40" aria-hidden="true" focusable="false">
  {icons[name].map((d, index) => <path d={d} pathLength="1" style={`--i: ${index}`} />)}
</svg>

<style>
  .service-icon path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.1s var(--ease-in-out);
    transition-delay: calc(0.35s + var(--i) * 0.14s);
  }

  :global(.js) :global([data-reveal]:not(.is-visible)) .service-icon path {
    stroke-dashoffset: 1;
  }
</style>
