---
import Icon from './Icon.astro';
import MakingTaxDigital from './MakingTaxDigital.astro';
import ServiceIcon from './ServiceIcon.astro';
import { company, services } from '../data/site';
---

<section id="services" class="services section theme-dark" aria-labelledby="services-title">
  <div class="services-bg" aria-hidden="true"></div>

  <div class="container">
    <header class="services-head">
      <div>
        <p class="label" data-reveal><span class="label-index">02</span> Services</p>
        <h2 id="services-title" class="services-title" data-reveal style="--stagger: 1">
          Our <span class="accent">services</span>
        </h2>
      </div>
      <p class="services-kicker" data-reveal style="--stagger: 2">
        Why choose <strong>{company.name}</strong>?
      </p>
    </header>

    <ul class="services-grid" role="list" data-spotlight>
      {
        services.map((service, index) => (
          <li class="service" data-reveal style={`--stagger: ${index % 3}`}>
            <article class="service-card">
              <div class="service-top">
                <span class="service-icon-wrap">
                  <ServiceIcon name={service.icon} />
                </span>
                <span class="service-index" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <a class="service-link" href="#contact" data-enquire={service.topic}>
                Enquire about {service.topic}
                <Icon name="arrow-right" size={16} />
              </a>
            </article>
          </li>
        ))
      }
    </ul>

    <MakingTaxDigital />
  </div>
</section>

<style>
  .services {
    isolation: isolate;
    margin-top: calc(var(--radius-xl) * -1);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    background: var(--ink-900);
    overflow: clip;
  }

  .services-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(50% 40% at 85% 0%, rgb(3 169 244 / 0.2), transparent 70%),
      radial-gradient(45% 35% at 0% 100%, rgb(63 217 160 / 0.08), transparent 70%);
  }

  /* faint ledger columns */
  .services-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: calc((min(100vw, 1220px)) / 6) 100%;
    background-position: center;
    mask-image: linear-gradient(180deg, #000, transparent 85%);
  }

  .services-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .services-head > div {
    display: grid;
    gap: 1.25rem;
  }

  .services-title {
    font-size: var(--step-5);
    letter-spacing: -0.045em;
  }

  .services-title .accent {
    color: var(--brand-300);
  }

  .services-kicker {
    max-width: 22rem;
    font-size: var(--step-1);
    color: var(--slate-300);
  }

  .services-kicker strong {
    color: var(--white);
    font-weight: 650;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .service {
    display: flex;
  }

  .service-card {
    --mx: 50%;
    --my: 0%;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    padding: 1.75rem 1.6rem 1.6rem;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(420px circle at var(--mx) var(--my), rgb(54 186 246 / 0.1), transparent 45%),
      linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.02));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    transition:
      translate 0.5s var(--ease-out),
      box-shadow 0.5s ease;
  }

  /* border that lights up around the cursor */
  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(260px circle at var(--mx) var(--my), rgb(111 205 248 / 0.9), transparent 60%);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .services-grid:hover .service-card::before {
    opacity: 1;
  }

  .service-card:hover {
    translate: 0 -4px;
  }

  .service-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0.9rem;
  }

  .service-icon-wrap {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 1.2rem;
    color: var(--brand-300);
    background: linear-gradient(160deg, rgb(3 169 244 / 0.2), rgb(3 169 244 / 0.05));
    box-shadow: inset 0 0 0 1px rgb(54 186 246 / 0.25);
  }

  .service-index {
    font-family: var(--font-code);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    color: var(--slate-400);
  }

  .service-card h3 {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
  }

  .service-card p {
    flex: 1;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--slate-300);
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    align-self: flex-start;
    margin-top: 0.6rem;
    padding-block: 0.3rem;
    color: var(--brand-300);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgb(111 205 248 / 0.3);
    transition:
      color 0.3s ease,
      border-color 0.3s ease;
  }

  .service-link :global(svg) {
    transition: translate 0.35s var(--ease-out);
  }

  .service-link:hover {
    color: var(--white);
    border-color: var(--white);
  }

  .service-link:hover :global(svg) {
    translate: 3px 0;
  }

  @media (max-width: 1080px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .services-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .service-card {
      padding: 1.5rem 1.3rem 1.4rem;
    }
  }
</style>

<script>
  import { hasFinePointer } from '../scripts/motion';

  // Spotlight: every card tracks the cursor so the glow flows across the grid.
  const grid = document.querySelector<HTMLElement>('[data-spotlight]');
  if (grid && hasFinePointer()) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.service-card'));
    let frame = 0;
    let pointer = { x: 0, y: 0 };

    const paint = () => {
      frame = 0;
      const rects = cards.map((card) => card.getBoundingClientRect());
      cards.forEach((card, index) => {
        const rect = rects[index]!;
        card.style.setProperty('--mx', `${(pointer.x - rect.left).toFixed(0)}px`);
        card.style.setProperty('--my', `${(pointer.y - rect.top).toFixed(0)}px`);
      });
    };

    grid.addEventListener('pointermove', (event) => {
      pointer = { x: event.clientX, y: event.clientY };
      if (!frame) frame = requestAnimationFrame(paint);
    });
  }
</script>
