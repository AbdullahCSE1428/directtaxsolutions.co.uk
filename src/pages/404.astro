---
import Icon from '../components/Icon.astro';
import Odometer from '../components/Odometer.astro';
import StatusPage from '../components/StatusPage.astro';
---

<StatusPage
  title="Page not found | Direct Tax Solutions Ltd"
  kicker="Error 404"
  heading="We couldn’t find that page"
  text="The page may have moved, or the link may be mistyped. Everything you need is on our home page."
>
  <div slot="visual" class="not-found-digits" data-reveal>
    <Odometer value="404" />
  </div>
  <a class="btn btn-primary" href="/">
    Back to home
    <Icon name="arrow-right" class="btn-arrow" />
  </a>
  <a class="btn btn-ghost" href="/#contact">Contact us</a>
</StatusPage>

<style>
  .not-found-digits :global(.odometer) {
    font-size: clamp(3.5rem, 2rem + 8vw, 7rem);
  }
</style>
